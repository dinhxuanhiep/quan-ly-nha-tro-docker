<?php
$host = 'db';
$db   = 'nhatro_db';
$user = 'admin';
$pass = 'password123';
$charset = 'utf8mb4';

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";
try {
    $pdo = new PDO($dsn, $user, $pass);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    
    // TẠO BẢNG V4: Bổ sung thêm cột ngay_sua_xong
    $pdo->exec("
        CREATE TABLE IF NOT EXISTS phong_tro_v4 (
            id INT AUTO_INCREMENT PRIMARY KEY,
            so_phong VARCHAR(50) NOT NULL,
            dia_chi VARCHAR(255) NOT NULL,
            gia_tien INT NOT NULL,
            trang_thai VARCHAR(50) NOT NULL,
            dien_tich INT NOT NULL,
            tien_ich VARCHAR(255) NOT NULL,
            hinh_anh VARCHAR(500) NOT NULL,
            ten_chu_thue VARCHAR(100) DEFAULT '',
            ngay_sua_xong DATE NULL
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
    ");

    // Nạp dữ liệu mẫu V4 (Thêm ngày dự kiến sửa xong cho phòng P201)
    $check = $pdo->query("SELECT COUNT(*) FROM phong_tro_v4")->fetchColumn();
    if ($check == 0) {
        $pdo->exec("INSERT INTO phong_tro_v4 (so_phong, dia_chi, gia_tien, trang_thai, dien_tich, tien_ich, hinh_anh, ten_chu_thue, ngay_sua_xong) VALUES 
        ('P101', 'Số 10, Ngõ 20 Cầu Giấy', 2500000, 'Đang thuê', 20, 'Điều hòa, Nóng lạnh, Giường tủ', 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=600&q=80', 'Nguyễn Văn A', NULL),
        ('P102', '15 Lê Thanh Nghị, Hai Bà Trưng', 3000000, 'Trống', 25, 'Điều hòa, Nóng lạnh, Máy giặt, Ban công', 'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=600&q=80', '', NULL),
        ('P201', 'Ngõ 30 Tạ Quang Bửu', 2800000, 'Đang sửa chữa', 22, 'Nóng lạnh, Quạt trần', 'https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=600&q=80', '', '2026-04-15')");
    }
} catch (\PDOException $e) {
    die("Lỗi kết nối DB: " . $e->getMessage());
}

// 1. XỬ LÝ THÊM PHÒNG TRỌ MỚI
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['add_room'])) {
    $ten_khach = ($_POST['trang_thai'] === 'Đang thuê') ? $_POST['ten_chu_thue'] : ''; 
    $ngay_sua  = ($_POST['trang_thai'] === 'Đang sửa chữa' && !empty($_POST['ngay_sua_xong'])) ? $_POST['ngay_sua_xong'] : NULL;
    
    $stmt = $pdo->prepare('INSERT INTO phong_tro_v4 (so_phong, dia_chi, gia_tien, trang_thai, dien_tich, tien_ich, hinh_anh, ten_chu_thue, ngay_sua_xong) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)');
    $stmt->execute([
        $_POST['so_phong'], $_POST['dia_chi'], $_POST['gia_tien'], $_POST['trang_thai'], 
        $_POST['dien_tich'], $_POST['tien_ich'], $_POST['hinh_anh'], $ten_khach, $ngay_sua
    ]);
    
    header("Location: /");
    exit;
}

// 2. XỬ LÝ TÌM KIẾM
$search_name      = $_GET['search_name'] ?? '';
$search_price     = $_GET['search_price'] ?? '';
$search_address   = $_GET['search_address'] ?? '';
$search_status    = $_GET['search_status'] ?? 'Tất cả';
$search_area      = $_GET['search_area'] ?? '';
$search_amenities = $_GET['search_amenities'] ?? '';
$search_tenant    = $_GET['search_tenant'] ?? '';

$query = "SELECT * FROM phong_tro_v4 WHERE 1=1";
$params = [];

if ($search_name !== '') { $query .= " AND so_phong LIKE ?"; $params[] = "%$search_name%"; }
if ($search_price !== '') { $query .= " AND gia_tien <= ?"; $params[] = $search_price; }
if ($search_address !== '') { $query .= " AND dia_chi LIKE ?"; $params[] = "%$search_address%"; }
if ($search_status !== 'Tất cả') { $query .= " AND trang_thai = ?"; $params[] = $search_status; }
if ($search_area !== '') { $query .= " AND dien_tich >= ?"; $params[] = $search_area; }
if ($search_amenities !== '') { $query .= " AND tien_ich LIKE ?"; $params[] = "%$search_amenities%"; }
if ($search_tenant !== '') { $query .= " AND ten_chu_thue LIKE ?"; $params[] = "%$search_tenant%"; }

$stmt = $pdo->prepare($query);
$stmt->execute($params);
$rooms = $stmt->fetchAll(PDO::FETCH_ASSOC);
?>

